<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="maintenance_hub.MaintenanceCard" owl="1">
        <div t-attf-class="maintenance-card priority-#{props.request.priority} compact-card shadow-sm mb-2" t-on-dragstart="onDragStart" draggable="true">
            <div class="d-flex justify-content-between align-items-start mb-2" style="height: 20px;">
                <h6 t-att-title="props.request.name" class="card-title text-truncate fw-bolder mb-0">
                    <t t-esc="props.request.name" />
                </h6>
                <span t-attf-class="status-indicator status-#{props.request.kanban_state} mt-1" />
                <div>
                    <button t-on-click="onCardClick" class="btn btn-link text-info p-0 ms-2">
                        <i class="fa fa-edit" />
                    </button>
                    <button t-on-click.stop="onDeleteClick" class="btn btn-link text-danger p-0 ms-2">
                        <i class="fa fa-trash" />
                    </button>
                </div>
            </div>
            <div class="row g-0 mb-2 border-bottom pb-1" style="height: 18px; font-size: 0.7rem;">
                <div class="col-7 text-truncate text-muted">
                    <t t-if="props.request.equipment_id">
                        <i class="fa fa-cube me-1 info-icon-equip" />
                        <t t-esc="props.request.equipment_id[1]" />
                    </t>
                </div>
                <div class="col-5 text-end text-muted">
                    <t t-if="props.request.request_date">
                        <i class="fa fa-paper-plane-o me-1 opacity-75" />
                        <t t-esc="props.request.request_date" />
                    </t>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-2" style="height: 20px;">
                <div class="d-flex gap-2 flex-grow-1 overflow-hidden">
                    <div class="d-flex align-items-center overflow-hidden" style="width: 45%;">
                        <i class="fa fa-user-o info-icon-req me-1" style="font-size: 0.7rem;" />
                        <span class="text-truncate text-muted small">
                            <t t-if="props.request.create_uid" t-esc="props.request.create_uid[1]" />
                            <t t-else="">---</t>
                        </span>
                    </div>
                    <div class="d-flex align-items-center border-start ps-2 overflow-hidden" style="width: 45%;">
                        <i class="fa fa-wrench info-icon-user me-1" style="font-size: 0.7rem;" />
                        <span class="text-truncate text-muted small">
                            <t t-if="props.request.user_id" t-esc="props.request.user_id[1]" />
                            <t t-else="">Unassigned</t>
                        </span>
                    </div>
                </div>
                <span t-attf-class="badge-priority bg-priority-#{props.request.priority} ms-1">
                    <t t-if="props.request.priority == '3'">H</t>
                    <t t-if="props.request.priority == '2'">M</t>
                    <t t-if="props.request.priority == '1'">L</t>
                </span>
            </div>
            <div class="pt-1 border-top d-flex justify-content-between align-items-center fw-bold" style="font-size: 0.65rem; color: #64748b; height: 18px;">
                <span class="text-nowrap">
                    <i class="fa fa-calendar-o me-1" />
                    <t t-esc="formatDate(props.request.schedule_date)" />
                </span>
                <i class="fa fa-long-arrow-right opacity-50 px-1" />
                <span class="text-nowrap">
                    <t t-esc="formatDate(props.request.schedule_end)" />
                </span>
            </div>
        </div>
    </t>
</templates>