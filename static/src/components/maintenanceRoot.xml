<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="maintenance_hub.MaintenanceRoot">
        <div class="maintenance-hub-root">
            <div class="d-flex justify-content-between align-items-center mb-4 ">
                <h2 class="text-primary fw-bold m-0">Maintenance Hub</h2>
                <div class="input-group w-50 rounded-pill ">
                    <span class="input-group-text bg-white border-end-0 rounded-start-pill ">
                        <i class="fa fa-search text-muted" />
                    </span>
                    <input t-model="state.searchTerm" type="text" class="form-control border-start-0 rounded-end-pill bg-white" placeholder="Search..." />
                </div>
                <div class="d-flex gap-2">
                    <button t-on-click="openNewRequestModal" class="btn btn-primary shadow-sm rounded-pill px-4">
                        <i class="fa fa-plus me-2" />
                        New Request
                    </button>
                </div>
            </div>
            <div class="row g-4">
                <t t-foreach="stages" t-as="stage" t-key="stage.id">
                    <div class="col-md-3">
                        <div class="stage-column">
                            <div class="stage-header d-flex justify-content-between align-items-center">
                                <h6 class="stage-title">
                                    <t t-esc="stage.name" />
                                </h6>
                                <span class="stage-count">
                                    <t t-esc="getRequestsByStage(stage.id).length" />
                                </span>
                            </div>
                            <div t-on-dragover.prevent="onDragOver" t-on-drop="(ev) => this.onDrop(stage.id, ev)" class="stage-body">
                                <t t-foreach="getRequestsByStage(stage.id)" t-as="request" t-key="request.id">
                                    <MaintenanceCard request="request" onDelete="(id)=> this.deleteRequest(id)" />
                                </t>
                                <t t-if="getRequestsByStage(stage.id).length == 0">
                                    <div class="empty-state">
                                        <i class="fa fa-inbox" />
                                        <div class="empty-state-text">No Requests</div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>