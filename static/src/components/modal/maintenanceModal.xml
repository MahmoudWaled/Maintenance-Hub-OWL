<?xml version="1.0" encoding="utf-8"?>
<t t-name="maintenance_hub.MaintenanceModal" owl="1">
    <Dialog title="'New Maintenance Request'" size="'md'">
        <div class="modal-body p-4 bg-100">
            <div class="mb-3">
                <label class="form-label fw-bold text-dark small">
                    Request Title
                    <span class="text-danger">*</span>
                </label>
                <input t-attf-class="form-control form-control border-secondary bg-white rounded-2 #{state.nameIsEmpty ? 'is-invalid' : ''}" t-model="state.requestData.name" t-on-input="clearNameError" type="text" />
                <span t-if="state.nameIsEmpty" class="invalid-feedback">Please enter a valid request name.</span>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label fw-bold text-dark small">Responsible</label>
                    <select t-model="state.requestData.user_id" class="form-select form-select-sm border-secondary bg-white rounded-2">
                        <option value="">Select Technician...</option>
                        <t t-foreach="state.users" t-as="user" t-key="user.id">
                            <option t-att-value="user.id">
                                <t t-esc="user.name" />
                            </option>
                        </t>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold text-dark small">Equipment</label>
                    <select t-model="state.requestData.equipment_id" class="form-select form-select-sm border-secondary bg-white rounded-2">
                        <option value="">Select...</option>
                        <t t-foreach="state.equipments" t-as="equipment" t-key="equipment.id">
                            <option t-att-value="equipment.id">
                                <t t-esc="equipment.name" />
                            </option>
                        </t>
                    </select>
                </div>
            </div>
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-4">
                    <label class="form-label fw-bold text-dark small">Priority</label>
                    <div class="priority-box-wrapper border border-secondary rounded bg-white d-flex align-items-center justify-content-center">
                        <t t-foreach="['1', '2', '3']" t-as="star" t-key="star">
                            <i t-attf-class="fa fa-star mx-1 cursor-pointer #{state.requestData.priority >= star ? 'text-warning' : 'text-400'}" t-on-click="() => this.setPriority(star)" />
                        </t>
                    </div>
                </div>
                <div class="col-4">
                    <label class="form-label fw-bold text-primary small">Start</label>
                    <input t-model="state.requestData.schedule_date" type="date" class="form-control form-control border-secondary bg-white rounded-2" />
                </div>
                <div class="col-4">
                    <label class="form-label fw-bold text-danger small">End</label>
                    <input t-model="state.requestData.schedule_end" type="date" class="form-control form-control border-secondary bg-white rounded-2" />
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label fw-bold text-dark small">Notes</label>
                <textarea t-model="state.requestData.description" class="form-control border-secondary bg-white rounded-2" style="height: 60px; font-size: 0.9rem;" />
            </div>
        </div>
        <t t-set-slot="footer">
            <button t-on-click="save" class="btn btn-primary px-4">Save</button>
            <button t-on-click="props.close" class="btn btn-secondary px-4">Cancel</button>
        </t>
    </Dialog>
</t>